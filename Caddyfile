# Static file server for the speed test page.
#
# The headers matter here: this host is one of the contenders, so it sends
# Timing-Allow-Origin, which is what lets a page on another origin read the
# DNS / connect / TTFB / download breakdown rather than just a total.
{
	admin off # no admin API needed in Railway's environment
	persist_config off # storage is not persistent anyway
	auto_https off # Railway terminates TLS in front of us

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:8080} {
	log {
		format json
	}

	root * /srv
	encode gzip

	header {
		# Let cross-origin pages read the detailed resource timings and the
		# transferred byte count. Without this a visitor only sees the total.
		Timing-Allow-Origin "*"
		Access-Control-Allow-Origin "*"
		-Server
	}

	# The sample images are content-addressed by name and never change.
	# The test appends a unique ?cb= token to every request, so this does not
	# stop the measurements from being honest — it only helps ordinary visitors.
	header /assets/*.jpg Cache-Control "public, max-age=31536000, immutable"

	file_server
}
